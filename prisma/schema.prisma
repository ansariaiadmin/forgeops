// ForgeOps — Prisma schema (SQLite for development)
//
// Domain model v2: User, Workspace, Project and the full ForgeOps
// ecosystem (Docker services, agents, RAG, backups, audit, tasks, ...).
//
// Conventions:
// - UUID primary keys everywhere (@default(uuid()))
// - Ownership chains cascade on delete (Workspace → Project → children)
// - Soft references (lastEditedBy, assignedTo, audit userId/projectId)
//   use onDelete: SetNull so history survives user/project removal
// - Indexes on hot query fields: projectId, userId, status

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum Environment {
  DEV
  STAGING
  PROD
}

enum ServiceStatus {
  RUNNING
  STOPPED
  ERROR
  UNKNOWN
}

enum MemoryCategory {
  ARCHITECTURE
  DECISION
  BUG
  CONVENTION
  TODO
}

enum MCPStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AgentType {
  DEVELOPER
  DEVOPS
  REVIEWER
  DOCUMENTER
  PRODUCT
}

enum AgentStatus {
  IDLE
  RUNNING
  ERROR
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DocumentType {
  README
  API_DOCS
  ARCHITECTURE
  GUIDE
  OTHER
}

enum RAGSourceType {
  FILE
  DOCUMENT
  GIT
  URL
  PDF
  WIKI
}

enum BackupType {
  VOLUME
  DATABASE
  CONFIG
  MEMORY
}

enum BackupStatus {
  CREATING
  READY
  FAILED
}

enum TaskStatus {
  BACKLOG
  RUNNING
  REVIEW
  DONE
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─────────────────────────────── Models ───────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  avatar    String? // URL or data URI
  role      Role      @default(VIEWER)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownedWorkspaces    Workspace[]
  ownedProjects      Project[]
  projectMemberships ProjectMember[]
  documentsEdited    Document[]
  auditLogs          AuditLog[]
  tasksAssigned      Task[]
  resetTokens        PasswordResetToken[]

  @@index([lastLogin])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // sha256 of the raw token — never store the token itself
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerId])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  slug        String
  description String?
  workspaceId String
  ownerId     String
  status      ProjectStatus @default(ACTIVE)
  environment Environment   @default(DEV)
  techStack   Json? // e.g. ["Next.js", "Docker", "PostgreSQL"]
  healthScore Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members              ProjectMember[]
  dockerServices       DockerService[]
  environmentVariables EnvironmentVariable[]
  memories             ProjectMemory[]
  mcpConnections       MCPConnection[]
  agents               Agent[]
  jobs                 AgentJob[]
  documents            Document[]
  ragSources           RAGSource[]
  auditLogs            AuditLog[]
  backups              Backup[]
  tasks                Task[]

  // Slug is unique within a workspace.
  @@unique([workspaceId, slug])
  @@index([ownerId])
  @@index([status])
  @@index([environment])
}

model ProjectMember {
  userId    String
  projectId String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model DockerService {
  id           String        @id @default(uuid())
  projectId    String
  name         String
  image        String
  containerId  String?
  status       ServiceStatus @default(UNKNOWN)
  ports        Json? // e.g. { "80": "3000" }
  volumes      Json?
  networks     Json?
  healthStatus String        @default("unknown")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model EnvironmentVariable {
  id          String      @id @default(uuid())
  projectId   String
  key         String
  // value is encrypted at rest (AES-256-GCM) before persisting — plaintext
  // is never stored. TODO: implement in lib/crypto (respects isSecret).
  value       String
  isSecret    Boolean     @default(false)
  environment Environment @default(DEV)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One key per environment per project.
  @@unique([projectId, environment, key])
  @@index([environment])
}

model ProjectMemory {
  id        String         @id @default(uuid())
  projectId String
  category  MemoryCategory
  title     String
  content   String
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
}

model MCPConnection {
  id              String    @id @default(uuid())
  projectId       String
  name            String
  type            String // e.g. "filesystem", "github", "custom"
  status          MCPStatus @default(DISCONNECTED)
  config          Json?
  allowedTools    Json? // ["read_file", "write_file", ...]
  scopes          Json? // permission scopes
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model Agent {
  id              String      @id @default(uuid())
  name            String
  type            AgentType   @default(DEVELOPER)
  projectId       String? // null = global/shared agent
  model           String      @default("gpt-4")
  systemPrompt    String
  tools           Json? // ["read_file", "run_command", ...]
  mcpIds          Json? // MCPConnection ids this agent may use
  status          AgentStatus @default(IDLE)
  totalTokensUsed Int         @default(0)
  totalCost       Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  project Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  jobs    AgentJob[]
  tasks   Task[]

  @@index([projectId])
  @@index([type])
  @@index([status])
}

model AgentJob {
  id          String    @id @default(uuid())
  agentId     String
  projectId   String
  task        String
  status      JobStatus @default(PENDING)
  result      String?
  error       String?
  tokensUsed  Int       @default(0)
  cost        Float     @default(0)
  startedAt   DateTime?
  completedAt DateTime?

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([projectId])
  @@index([status])
}

model Document {
  id           String       @id @default(uuid())
  projectId    String
  title        String
  content      String       @default("") // Markdown
  path         String // file path inside the project
  type         DocumentType @default(OTHER)
  version      Int          @default(1)
  lastEditedBy String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastEditor User?   @relation(fields: [lastEditedBy], references: [id], onDelete: SetNull)

  // One document per file path per project.
  @@unique([projectId, path])
  @@index([type])
}

model RAGSource {
  id            String        @id @default(uuid())
  projectId     String
  type          RAGSourceType
  path          String
  isIndexed     Boolean       @default(false)
  lastIndexedAt DateTime?
  chunks        Json? // [{ id, text, meta }]
  // embeddings: when moving to Postgres, switch to
  // Unsupported("vector(1536)") + the pgvector extension.
  embeddings    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([isIndexed])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  projectId String?
  action    String // e.g. "project.deleted"
  resource  String // e.g. "project:abc-123"
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Append-only: no updatedAt — audit entries are immutable.
  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([createdAt])
}

model Backup {
  id        String       @id @default(uuid())
  projectId String
  type      BackupType
  path      String
  size      Int          @default(0) // bytes
  status    BackupStatus @default(CREATING)
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Append-only: no updatedAt — backup records are immutable snapshots.
  @@index([projectId])
  @@index([status])
}

model Task {
  id            String       @id @default(uuid())
  projectId     String
  title         String
  description   String?
  status        TaskStatus   @default(BACKLOG)
  priority      TaskPriority @default(MEDIUM)
  assignedTo    String?
  assignedAgent String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  agent    Agent?  @relation(fields: [assignedAgent], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
}
