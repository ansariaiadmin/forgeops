# ============================================
# ForgeOps — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh — جادوگر با راهنما همون‌جا
# ============================================

# --- App — خودکار — جادوگر رمز می‌سازه ---
NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-64-hex-chars-32-bytes

# --- Database — خودکار ---
DATABASE_URL=postgresql://forgeops:change-me@db:5432/forgeops?schema=public
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=forgeops

# --- AI — RAG — اختیاری — با راهنما ---
# چیه؟ هوش مصنوعی برای جستجوی کد — RAG
# گزینه‌ها: openai (https://platform.openai.com/api-keys), mock
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...

# --- Email + SMS — برای ناتیف DevOps ---
# چیه؟ وقتی پروژه خطا می‌خوره یا دیپلوی می‌شه ناتیف می‌ده
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass
SMS_PROVIDER=mock
SMS_API_KEY=

# --- Notification System — سیستم ناتیف — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی خطا + دیپلوی + لاگ — کانال‌ها: in_app + email + telegram (برای تیم DevOps)
# تلگرام می‌تونه گروه باشه — Chat ID گروه رو بذار
NOTIF_IN_APP=true
NOTIF_EMAIL=true
NOTIF_SMS=false
NOTIF_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
