# ForgeOps — environment template
# Copy to .env and fill secrets: cp .env.example .env

# ── App ──
NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-64-hex-chars-32-bytes

# ── Database ──
# SQLite (dev):
# DATABASE_URL=file:./prisma/dev.db
# Postgres (prod):
DATABASE_URL=postgresql://forgeops:change-me@db:5432/forgeops?schema=public

POSTGRES_USER=forgeops
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=forgeops

# ── Optional LLM ──
# OPENAI_API_KEY=sk-...
